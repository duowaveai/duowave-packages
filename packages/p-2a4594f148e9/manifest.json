  "version": "0.1.5",
  "title": "VPN",
  "description": "Свои серверы для DuoWave: подписка или ссылки (VLESS с Reality и XHTTP, Hysteria 2, TUIC, Shadowsocks 2022, Trojan, AnyTLS, WireGuard). Шлюз сам решает, кому идти через сервер, а кому напрямую: модели, слух и голос, разговор колонки, приложения — каждый своей строкой. Только для колонки.",
  "languages": [
    "ru",
    "en"
  ],
  "locales": {
    "en": {
      "title": "VPN",
      "description": "Your own servers for DuoWave: a subscription or links (VLESS with Reality and XHTTP, Hysteria 2, TUIC, Shadowsocks 2022, Trojan, AnyTLS, WireGuard). The gateway decides who goes through a server and who goes directly: models, hearing and voice, the speaker’s own talk, apps — each on its own line. Speaker only.",
      "settings": {
        "homeCountry": {
          "title": "Home country",
          "description": "Where your home is: a country code (RU, DE…) or none — “I won't say”. The VPN window asks it itself; by it “Internet access” decides what works from here directly."
        }
      }
    }
  },
  "license": "Apache-2.0; движок shoes — MIT, его часть WireGuard — MPL-2.0 (SOURCE.md)",
  "icon": "avatar.webp",
  "api": "^2",
  "minGateway": "0.17.2",
  "runs": [
    "station"
  ],
  "resident": true,
  "targets": {
    "linux-aarch64": {
      "file": "bin/duowave-own-server-linux-aarch64",
