{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES2023"],
    "baseUrl": ".",
    "paths": { "@feed/*": ["./*"] }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
